--- !u!114 &6003640406191093388
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3293887537856029561}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0046ef3e890557f4a857c2dea274cd94, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  noteUI: {fileID: 0}
  noteText: {fileID: 0}
  noteImage: {fileID: 0}
  interactionText: {fileID: 0}
  noteContent: "\u201CMi nombre fue Mateo Vargas.  \r\nEn la sequ\xEDa de 1832 vi
    morir a mis hijos, y con ellos, la fe.  \r\nLos ricos ten\xEDan grasa, los pobres
    solo hueso.  \r\nUn hombre vestido de blanco me habl\xF3 de curas, de una ciencia
    nueva que pod\xEDa salvarnos,  \r\nsi consegu\xEDa materia humana\u2026 la llam\xF3
    \u2018sustancia vital\u2019.  \r\n\r\nPrimero fueron animales. Luego cuerpos
    enfermos.  \r\nDespu\xE9s, la oscuridad me pidi\xF3 m\xE1s.  \r\n\r\nJur\xE9
    que lo hac\xEDa por amor, por sanar.  \r\nPero el hambre de redenci\xF3n se volvi\xF3
    otra clase de hambre.  \r\n\r\nAhora me llaman Kharisiri.  \r\nY a\xFAn busco,
    no grasa\u2026 sino perd\xF3n.\u201D  \r\n\n"
  noteSprite: {fileID: 21300000, guid: 291e5d23598c68e49946d63e6012a9cf, type: 3}
  playerControl: {fileID: 0}
